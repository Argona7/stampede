# Copy to .env (chmod 600). Never commit .env. Values are never printed by the tool.

# Alchemy app key for Robinhood Chain mainnet (robinhood-mainnet). Used for:
# - block timestamp anchors, eth_call batches, receipt cross-checks.
# Free tier: eth_getLogs capped at a 10-block range, ~330 CU/s.
ALCHEMY_KEY=

# Envio HyperSync API token (free): https://envio.dev/app/api-tokens
# Without it the ingest falls back to the public RPC (slower, rate-limited).
HYPERSYNC_TOKEN=

# Optional overrides
# PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com
# STAMPEDE_DB=data/stampede.sqlite

# Optional: where `stampede demo` downloads the recorded sample bundle from when data/demo/ has none
# (default: the GitHub release asset baked into stampede/demo.py)
# STAMPEDE_DEMO_URL=

# twitterapi.io key for the X mentions module (optional; radar works without it)
TWITTERAPI_KEY=
